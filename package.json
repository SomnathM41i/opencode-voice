{
  "name": "opencode-voice",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "opencode": "node scripts/start-opencode.mjs",
    "lan": "node scripts/lan.mjs",
    "typecheck": "tsc --noEmit",
    "verify": "node --no-warnings scripts/verify-speech.mjs && node --no-warnings scripts/verify-chat.mjs && node --no-warnings scripts/verify-lan.mjs"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "typescript": "^5.9.3"
  }
}
